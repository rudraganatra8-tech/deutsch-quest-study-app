/* Deutsch Quest — bright, friendly study-app styling */
:root {
  color-scheme: light;
  --ink: #242744;
  --muted: #777b98;
  --purple: #6257e8;
  --purple-dark: #443ab8;
  --pink: #f36b8b;
  --orange: #ff9b58;
  --mint: #3cbf9c;
  --sky: #61b9f5;
  --paper: #f6f7ff;
  --line: #e9eaf5;
  --white: #fff;
  --shadow: 0 16px 42px rgba(53, 48, 117, .09);
  --shadow-small: 0 8px 22px rgba(53, 48, 117, .07);
  --radius: 22px;
}

* { box-sizing: border-box; }

html { min-width: 320px; scroll-behavior: smooth; }

body {
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(ellipse at 85% 0%, rgba(215, 209, 255, .43), transparent 31rem),
    radial-gradient(ellipse at 0% 80%, rgba(203, 243, 235, .34), transparent 29rem),
    var(--paper);
  font-family: "Segoe UI", "Aptos", ui-rounded, system-ui, -apple-system, sans-serif;
  font-size: 15px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

button, textarea, input { font: inherit; }
button { color: inherit; }
button:focus-visible, a:focus-visible, textarea:focus-visible, input:focus-visible {
  outline: 3px solid rgba(98, 87, 232, .42);
  outline-offset: 3px;
}

::selection { color: #332b80; background: #e5e0ff; }

.app-frame {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 252px minmax(0, 1fr);
}

/* Left-hand course navigation */
.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 27px 17px 19px;
  color: #fff;
  background:
    radial-gradient(circle at 8% 8%, rgba(255,255,255,.14), transparent 11rem),
    linear-gradient(165deg, #302b76 0%, #4640a7 55%, #5550c8 100%);
  box-shadow: 9px 0 36px rgba(48, 43, 118, .12);
  z-index: 5;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 3px 7px 23px;
  color: #fff;
  text-decoration: none;
}

.brand > span:last-child { display: grid; gap: 1px; }
.brand strong { font-size: 17px; letter-spacing: -.35px; }
.brand small { color: rgba(255,255,255,.69); font-size: 11px; }

.brand-mark {
  width: 43px;
  height: 43px;
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  border: 2px solid rgba(255,255,255,.78);
  border-radius: 15px;
  color: #fff;
  background: linear-gradient(145deg, #ffb66c, #ff7185);
  box-shadow: 0 6px 16px rgba(18, 15, 61, .2), inset 0 1px 0 rgba(255,255,255,.45);
  font-size: 16px;
  font-weight: 900;
  letter-spacing: -2px;
  transform: rotate(-4deg);
}

.brand-mark span { color: #fff3a8; }

.course-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 4px 24px;
  padding: 9px 11px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 13px;
  color: rgba(255,255,255,.83);
  background: rgba(255,255,255,.09);
  font-size: 10px;
  font-weight: 750;
  letter-spacing: .55px;
}

.chip-dot, .online-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #69e1b5;
  box-shadow: 0 0 0 4px rgba(105,225,181,.13);
}
.chip-divider { opacity: .35; }

.side-nav { display: grid; gap: 7px; }

.nav-link {
  min-height: 47px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 14px;
  color: rgba(255,255,255,.75);
  background: transparent;
  text-align: left;
  cursor: pointer;
  transition: transform .18s ease, background .18s ease, color .18s ease;
}

.nav-link:hover { color: #fff; background: rgba(255,255,255,.12); transform: translateX(2px); }
.nav-link.active { color: #332f75; background: #fff; box-shadow: 0 7px 17px rgba(22,19,74,.18); font-weight: 800; }
.nav-link > span:first-child { width: 20px; color: #ffd976; font-size: 17px; text-align: center; }
.nav-link.active > span:first-child { color: var(--purple); }
.nav-link kbd { margin-left: auto; color: inherit; opacity: .48; font-family: inherit; font-size: 10px; font-weight: 700; }

.sidebar-bottom { display: grid; gap: 13px; margin-top: auto; padding: 16px 5px 0; }
.mini-streak { display: flex; align-items: center; gap: 9px; color: #fff4d1; font-size: 12px; }
.flame { display: inline-block; color: #ffbc57; filter: drop-shadow(0 3px 7px rgba(255,154,62,.3)); }
.offline-note { display: flex; align-items: center; gap: 9px; color: rgba(255,255,255,.62); font-size: 10px; }
.offline-note .online-dot { width: 6px; height: 6px; }

/* Main app shell */
.main-column { min-width: 0; }
.topbar {
  min-height: 78px;
  position: sticky;
  top: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px clamp(20px, 4vw, 54px);
  border-bottom: 1px solid rgba(224,226,242,.78);
  background: rgba(250,250,255,.84);
  backdrop-filter: blur(18px);
}

.mobile-brand { display: none; align-items: center; gap: 9px; }
.mobile-brand .brand-mark { width: 35px; height: 35px; border-radius: 12px; font-size: 13px; }
.mobile-brand strong { font-size: 14px; }
.breadcrumb { color: #989bb1; font-size: 10px; font-weight: 750; letter-spacing: 1.5px; }
.breadcrumb strong { color: var(--ink); }
.top-metrics { display: flex; align-items: center; gap: 9px; }
.metric-pill { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: #fff; box-shadow: 0 3px 10px rgba(43,41,91,.04); font-size: 12px; font-weight: 800; }
.metric-pill .flame { font-size: 16px; }
.xp-pill { color: #88641d; background: #fff8df; border-color: #ffebaf; }
.install-button { padding: 9px 14px; border: 0; border-radius: 12px; color: #fff; background: var(--purple); box-shadow: 0 5px 13px rgba(98,87,232,.23); font-size: 12px; font-weight: 800; cursor: pointer; }
.install-button:hover { background: var(--purple-dark); transform: translateY(-1px); }

#screen {
  width: min(1200px, 100%);
  margin: 0 auto;
  padding: 29px clamp(20px, 4vw, 54px) 64px;
  animation: page-in .42s cubic-bezier(.2,.8,.2,1) both;
}

.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin: 1px 0 22px; }
.page-head h1, .page-head h2 { margin: 5px 0 7px; color: var(--ink); font-size: clamp(25px, 3vw, 35px); line-height: 1.13; letter-spacing: -1.15px; }
.page-head p { max-width: 680px; margin: 0; color: var(--muted); font-size: 14px; }
.eyebrow { color: var(--purple); font-size: 10px; font-weight: 850; letter-spacing: 1.55px; text-transform: uppercase; }
.date-label { display: inline-flex; align-items: center; width: fit-content; padding: 7px 11px; border: 1px solid #e7e3ff; border-radius: 999px; color: #5e54c7; background: #f1efff; font-size: 11px; font-weight: 800; white-space: nowrap; }

/* Home dashboard */
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(260px, .82fr); gap: 18px; }
.hero-card, .streak-card, .progress-chart, .panel, .scope-banner, .lesson-card, .day-card, .reference-card {
  border: 1px solid rgba(230,231,245,.9);
  border-radius: var(--radius);
  box-shadow: var(--shadow-small);
}

.hero-card {
  min-height: 255px;
  position: relative;
  overflow: hidden;
  grid-column: 1;
  padding: clamp(25px, 3vw, 36px);
  color: #fff;
  background: linear-gradient(128deg, #6458e9 1%, #8b67e9 54%, #c26ee5 100%);
  box-shadow: 0 18px 40px rgba(96,78,213,.24);
  animation: card-rise .5s .04s both;
}

.hero-card::before, .hero-card::after { content: ""; position: absolute; pointer-events: none; }
.hero-card::before { width: 290px; height: 290px; top: -155px; right: -25px; border: 1px solid rgba(255,255,255,.22); border-radius: 50%; box-shadow: 0 0 0 25px rgba(255,255,255,.055), 0 0 0 54px rgba(255,255,255,.04); }
.hero-card::after { width: 130px; height: 130px; right: 9%; bottom: -83px; border-radius: 38px; background: rgba(255,255,255,.12); transform: rotate(32deg); }
.hero-card > * { position: relative; z-index: 1; }
.hero-card .eyebrow { width: fit-content; margin-bottom: 17px; padding: 7px 10px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: #fff4ba; background: rgba(255,255,255,.12); font-size: 9px; letter-spacing: 1.1px; }
.hero-card h2 { max-width: 490px; margin: 0 0 10px; color: #fff; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.08; letter-spacing: -1.6px; }
.hero-card p { max-width: 560px; margin: 0; color: rgba(255,255,255,.86); font-size: 14px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 23px; }

.streak-card { display: flex; flex-direction: column; justify-content: space-between; gap: 20px; min-height: 255px; padding: 24px; background: linear-gradient(145deg, #fff 25%, #fff5e9 100%); animation: card-rise .5s .1s both; }
.streak-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.streak-top h3 { margin: 0 0 5px; font-size: 17px; letter-spacing: -.3px; }
.streak-top p { margin: 0; color: var(--muted); font-size: 12px; }
.streak-top > .flame { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 15px; color: #f58e3f; background: #fff0d6; font-size: 22px; animation: flame-pop 2.2s ease-in-out infinite; }
.streak-number { margin: 5px 0 11px; font-size: 36px; font-weight: 900; line-height: 1; letter-spacing: -1px; }
.streak-number small { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: 0; }
.week-dots { display: flex; gap: 7px; }
.week-dot { width: 31px; height: 31px; display: grid; place-items: center; border: 1px solid #e9e7f3; border-radius: 50%; color: #9092aa; background: #fff; font-size: 9px; font-weight: 800; }
.week-dot.active, .week-dot.done { border-color: transparent; color: #fff; background: linear-gradient(135deg, #f7aa55, #f47772); box-shadow: 0 4px 9px rgba(244,119,114,.2); }

.stat-row { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.stat-card { min-height: 91px; position: relative; display: grid; grid-template-columns: 39px 1fr; grid-template-rows: auto auto; align-content: center; column-gap: 11px; padding: 15px 17px; border: 1px solid #e8e9f5; border-radius: 17px; background: #fff; box-shadow: 0 6px 18px rgba(53,48,117,.045); transition: transform .2s ease, box-shadow .2s ease; }
.stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-small); }
.stat-icon { grid-row: 1 / span 2; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 13px; color: #6558db; background: #f0eeff; font-size: 16px; }
.stat-card:nth-child(2) .stat-icon { color: #168f76; background: #e6f8f1; }
.stat-card:nth-child(3) .stat-icon { color: #cf7e32; background: #fff2dd; }
.stat-card strong { align-self: end; font-size: 19px; letter-spacing: -.45px; }
.stat-card small { align-self: start; color: var(--muted); font-size: 10px; }

.progress-chart { margin-top: 18px; padding: 21px 23px 18px; background: #fff; animation: card-rise .55s .14s both; }
.chart-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; margin-bottom: 13px; }
.chart-heading h2 { margin: 0 0 4px; font-size: 16px; letter-spacing: -.3px; }
.chart-heading p { margin: 0; color: var(--muted); font-size: 11px; }
.chart-key { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 10px; white-space: nowrap; }
.chart-key i { width: 8px; height: 8px; border-radius: 50%; background: var(--purple); }
.chart-bars { min-height: 148px; display: grid; grid-template-columns: repeat(12, minmax(17px, 1fr)); align-items: end; gap: clamp(4px, 1.2vw, 13px); padding: 9px 4px 0; }
.chart-column { min-width: 0; display: grid; grid-template-rows: 16px 1fr; justify-items: center; gap: 4px; }
.chart-percent { color: #8b8da7; font-size: 8px; font-weight: 700; }
.chart-bar-wrap { width: min(100%, 33px); height: 112px; display: flex; align-items: flex-end; overflow: hidden; border-radius: 10px 10px 4px 4px; background: #f1f0fb; }
.chart-bar { width: 100%; height: var(--bar, 5%); min-height: 5px; border-radius: 10px 10px 3px 3px; background: linear-gradient(180deg, #a593ff 0%, #6257e8 100%); transform-origin: bottom; animation: bar-grow .65s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--delay, 0ms); }
.chart-column:nth-child(11) .chart-bar, .chart-column:nth-child(12) .chart-bar { background: linear-gradient(180deg, #79d8bd, #36ae92); }
.chart-labels { display: grid; grid-template-columns: repeat(12, minmax(17px, 1fr)); gap: clamp(4px, 1.2vw, 13px); margin-top: 6px; text-align: center; color: #777b96; font-size: 9px; font-weight: 750; }
.chart-caption { margin-top: 9px; color: #a0a1b5; font-size: 9px; text-align: right; }

.content-grid { display: grid; grid-template-columns: minmax(0, 1.17fr) minmax(280px, .83fr); align-items: start; gap: 18px; margin-top: 18px; }
.panel { min-width: 0; padding: 21px; background: #fff; }
.panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 13px; margin-bottom: 15px; }
.panel-head h2 { margin: 0 0 4px; font-size: 17px; letter-spacing: -.45px; }
.panel-head small { color: var(--muted); font-size: 11px; }
.duration-toggle { display: flex; flex: 0 0 auto; gap: 3px; padding: 3px; border: 1px solid #e7e7f2; border-radius: 999px; background: #f5f5fb; }
.duration-toggle button { padding: 6px 9px; border: 0; border-radius: 999px; color: #7c7f99; background: transparent; font-size: 10px; font-weight: 800; cursor: pointer; }
.duration-toggle button.selected { color: #fff; background: var(--purple); box-shadow: 0 3px 8px rgba(98,87,232,.23); }
.task-list { display: grid; gap: 9px; }
.task-item { display: flex; align-items: flex-start; gap: 11px; padding: 12px 13px; border: 1px solid #edecf6; border-radius: 15px; background: #fcfcff; cursor: pointer; transition: border .18s ease, background .18s ease, transform .18s ease; }
.task-item:hover { border-color: #d7d2ff; background: #faf9ff; transform: translateY(-1px); }
.task-item:has(input:checked) { border-color: #b8eddb; background: #f0fbf6; }
.task-item input { width: 19px; height: 19px; flex: 0 0 auto; margin: 1px 0 0; accent-color: #36ae92; cursor: pointer; }
.task-item > span { display: grid; gap: 3px; }
.task-item strong { font-size: 12px; line-height: 1.45; }
.task-item small { color: var(--muted); font-size: 10px; }
.task-item:has(input:checked) strong { color: #547e70; text-decoration: line-through; text-decoration-color: #9ccfbd; }
.task-progress { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 14px 2px 9px; color: var(--muted); font-size: 10px; }
.progress-track, .quiz-progress { height: 8px; overflow: hidden; border-radius: 999px; background: #eeedf7; }
.progress-track { flex: 1; }
.progress-fill { width: var(--progress, 0%); height: 100%; border-radius: inherit; background: linear-gradient(90deg, #39c69e, #88d875); transition: width .5s cubic-bezier(.2,.8,.2,1); }
.claim-row { display: flex; justify-content: flex-end; }

.mission-card { margin: 8px 0; padding: 14px 15px; border: 1px solid #eeecfa; border-radius: 15px; background: linear-gradient(135deg, #fbfaff, #f4f2ff); }
.mission-card:nth-of-type(2) { background: linear-gradient(135deg, #f1fbf8, #f8fffc); border-color: #e0f3ed; }
.mini-label { display: inline-block; margin-bottom: 6px; color: var(--purple); font-size: 9px; font-weight: 850; letter-spacing: 1px; text-transform: uppercase; }
.mission-card strong { display: block; font-size: 12px; line-height: 1.5; }
.mission-card p { margin: 5px 0 0; color: var(--muted); font-size: 10px; }
.note-label { display: block; margin: 14px 0 6px; font-size: 11px; font-weight: 800; }
.daily-note { width: 100%; min-height: 90px; resize: vertical; padding: 11px 12px; border: 1px solid #e7e7f1; border-radius: 13px; color: var(--ink); background: #fdfdff; font-size: 12px; }
.daily-note::placeholder { color: #a4a6ba; }

.scope-banner { margin-top: 18px; padding: 15px 18px; border-color: #e3e1fb; color: #666987; background: linear-gradient(100deg, #f0efff, #fbf6ff); font-size: 11px; }
.scope-banner strong { color: #4d48a4; }
.scope-banner a { color: #554cc6; font-weight: 800; }

/* Buttons */
.btn { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 9px 15px; border: 1px solid transparent; border-radius: 12px; color: #fff; background: var(--purple); box-shadow: 0 5px 12px rgba(98,87,232,.18); font-size: 12px; font-weight: 800; cursor: pointer; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
.btn:hover:not(:disabled) { background: var(--purple-dark); box-shadow: 0 8px 16px rgba(98,87,232,.24); transform: translateY(-2px); }
.btn:active:not(:disabled) { transform: translateY(0) scale(.98); }
.btn.white { color: #4b41ac; background: #fff; box-shadow: 0 6px 15px rgba(35,25,116,.18); }
.btn.white:hover:not(:disabled) { color: #332b88; background: #f8f6ff; }
.btn.ghost { border-color: #e5e4f0; color: #686b87; background: #fff; box-shadow: none; }
.btn.ghost:hover:not(:disabled) { border-color: #cac5ff; color: var(--purple-dark); background: #f8f7ff; }
.btn.small { min-height: 34px; padding: 7px 12px; font-size: 10px; }
.btn:disabled { color: #a8a8b9; background: #ebebf2; box-shadow: none; cursor: not-allowed; }

/* Short-lesson library */
.lesson-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.lesson-card { min-width: 0; overflow: hidden; background: #fff; transition: transform .2s ease, box-shadow .2s ease; animation: card-rise .38s both; }
.lesson-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
.lesson-color { height: 8px; background: linear-gradient(90deg, var(--purple), #a985f3); }
.lesson-card:nth-child(4n + 2) .lesson-color { background: linear-gradient(90deg, #f47789, #ffb06e); }
.lesson-card:nth-child(4n + 3) .lesson-color { background: linear-gradient(90deg, #41bea0, #8bd7af); }
.lesson-card:nth-child(4n + 4) .lesson-color { background: linear-gradient(90deg, #4daee9, #9c9bf8); }
.lesson-body { padding: 18px 19px 17px; }
.lesson-tag { width: fit-content; display: block; margin-bottom: 8px; padding: 5px 8px; border-radius: 999px; color: #6459c9; background: #f0eeff; font-size: 9px; font-weight: 850; letter-spacing: .45px; }
.lesson-card h2, .lesson-card h3 { margin: 0 0 9px; font-size: 17px; line-height: 1.25; letter-spacing: -.4px; }
.lesson-card p { margin: 8px 0; color: #646984; font-size: 12px; line-height: 1.6; }
.lesson-card .example { margin: 11px 0; padding: 11px 12px; border-left: 3px solid #8273eb; border-radius: 0 11px 11px 0; color: #373667; background: #f7f5ff; font-size: 12px; font-weight: 700; }
.lesson-card .tip { margin-top: 11px; padding: 10px 11px; border: 1px solid #e0f2ea; border-radius: 11px; color: #477362; background: #f2fbf7; font-size: 11px; }
.lesson-card .btn { margin-top: 9px; }

/* Quiz, flashcards, route map, and extra resources */
.quiz-card { max-width: 760px; margin: 0 auto; padding: clamp(20px,4vw,32px); border: 1px solid var(--line); border-radius: 26px; background: #fff; box-shadow: var(--shadow); }
.quiz-progress { margin: 14px 0 24px; }
.quiz-progress .progress-fill { background: linear-gradient(90deg, #51c7a3, #72cbed); }
.quiz-question { margin: 20px 0; }
.quiz-question h2, .quiz-question h3 { margin: 0 0 9px; font-size: clamp(20px, 3vw, 28px); line-height: 1.25; letter-spacing: -.7px; }
.quiz-question p { color: var(--muted); }
.quiz-options { display: grid; gap: 10px; }
.quiz-option { width: 100%; padding: 13px 15px; border: 1px solid #e8e8f2; border-radius: 14px; color: var(--ink); background: #fcfcff; text-align: left; cursor: pointer; transition: transform .16s ease, border .16s ease, background .16s ease; }
.quiz-option:hover { border-color: #bdb6ff; background: #f8f7ff; transform: translateX(2px); }
.quiz-option.correct { border-color: #91dbbf; background: #effbf5; }
.quiz-option.wrong { border-color: #f1a5ad; background: #fff3f3; }
.quiz-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; }

.flash-card { min-height: 280px; display: grid; place-items: center; padding: 28px; border: 1px solid #e6e1ff; border-radius: 28px; color: #37315f; background: radial-gradient(circle at 85% 10%, rgba(255,255,255,.8), transparent 13rem), linear-gradient(145deg, #f1efff, #eafaf6 75%, #fff7e7); box-shadow: var(--shadow); text-align: center; cursor: pointer; transition: transform .22s ease, box-shadow .22s ease; }
.flash-card:hover { transform: translateY(-3px) rotate(-.35deg); box-shadow: 0 22px 46px rgba(53,48,117,.13); }
.flash-card h2 { margin: 12px 0; font-size: clamp(32px, 6vw, 52px); letter-spacing: -1.5px; }
.flash-card p { color: var(--muted); }
.flash-lang { color: var(--purple); font-size: 10px; font-weight: 850; letter-spacing: 1.4px; text-transform: uppercase; }
.flash-controls { display: flex; justify-content: center; gap: 10px; margin: 16px 0; }

.day-list { display: grid; gap: 10px; }
.day-card { display: grid; grid-template-columns: 54px minmax(0,1fr) auto; align-items: center; gap: 13px; padding: 13px 15px; background: #fff; transition: transform .18s ease, border .18s ease; }
.day-card:hover { transform: translateY(-2px); border-color: #ccc7ff; }
.day-card.selected { border: 2px solid #8b80f3; background: #f8f7ff; box-shadow: 0 8px 20px rgba(98,87,232,.1); }
.day-card > :first-child { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 15px; color: #6558d9; background: #f0eeff; font-size: 11px; font-weight: 900; }
.day-meta { min-width: 0; }
.day-meta strong { display: block; font-size: 13px; }
.day-meta small { display: block; overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.day-status { color: #8588a1; font-size: 10px; font-weight: 800; white-space: nowrap; }
.day-card.done .day-status { color: #168f76; }

.reference-note { margin-bottom: 14px; padding: 13px 15px; border: 1px solid #e5e1ff; border-radius: 15px; color: #5e5e83; background: #f7f5ff; font-size: 12px; }
.reference-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
.reference-card { min-width: 0; display: flex; gap: 13px; padding: 17px; background: #fff; transition: transform .18s ease, box-shadow .18s ease; }
.reference-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
.reference-icon { width: 43px; height: 43px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 14px; color: #fff; background: linear-gradient(145deg, #fa846f, #f3ad61); font-size: 12px; font-weight: 900; }
.reference-card:nth-child(2n) .reference-icon { background: linear-gradient(145deg, #685ce4, #ab78e5); }
.reference-card strong { display: block; margin: 0 0 5px; font-size: 13px; }
.reference-card p { margin: 0; color: var(--muted); font-size: 11px; }
.reference-card a { display: inline-block; margin-top: 9px; color: var(--purple); font-size: 11px; font-weight: 850; text-decoration: none; }
.reference-card a:hover { text-decoration: underline; }
.review-row { display: flex; align-items: flex-start; gap: 11px; padding: 11px 0; border-bottom: 1px solid #f0eff7; }
.review-row:last-child { border-bottom: 0; }
.review-row > span:last-child { display: grid; gap: 3px; }
.review-row strong { font-size: 12px; }
.review-row small { color: var(--muted); font-size: 10px; }
.check-emoji { width: 31px; height: 31px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 11px; background: #f2efff; }

.app-footer { padding: 18px 20px 27px; color: #9a9cb1; font-size: 10px; text-align: center; }
.toast { position: fixed; right: 20px; bottom: 20px; z-index: 20; max-width: min(360px, calc(100vw - 40px)); padding: 12px 16px; border: 1px solid rgba(255,255,255,.35); border-radius: 14px; color: #fff; background: #373273; box-shadow: var(--shadow); opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity .2s ease, transform .2s ease; }
.toast.show { opacity: 1; transform: translateY(0); }
.celebration { position: fixed; inset: 0; z-index: 19; overflow: hidden; pointer-events: none; }

.mobile-tabs { display: none; }

@keyframes page-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes card-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes bar-grow { from { transform: scaleY(.04); } to { transform: scaleY(1); } }
@keyframes flame-pop { 0%,100% { transform: rotate(-5deg) scale(1); } 50% { transform: rotate(5deg) scale(1.08); } }

@media (max-width: 1050px) {
  .app-frame { grid-template-columns: 218px minmax(0,1fr); }
  .sidebar { padding-inline: 13px; }
  .dashboard-grid { grid-template-columns: minmax(0,1.2fr) minmax(235px,.8fr); }
  #screen { padding-inline: 25px; }
}

@media (max-width: 800px) {
  .app-frame { display: block; }
  .sidebar { display: none; }
  .topbar { min-height: 66px; padding: 10px 18px; }
  .mobile-brand { display: flex; }
  .breadcrumb { display: none; }
  #screen { padding: 22px 18px 112px; }
  .mobile-tabs {
    position: fixed;
    inset: auto 0 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(6, minmax(0,1fr));
    gap: 2px;
    padding: 8px max(8px, env(safe-area-inset-right)) calc(8px + env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left));
    border-top: 1px solid rgba(224,226,242,.88);
    background: rgba(255,255,255,.94);
    box-shadow: 0 -9px 26px rgba(45,43,96,.08);
    backdrop-filter: blur(18px);
  }
  .mobile-tabs button { min-width: 0; min-height: 49px; display: grid; place-items: center; align-content: center; gap: 1px; padding: 4px 1px; border: 0; border-radius: 12px; color: #898ba3; background: transparent; font-size: 9px; font-weight: 750; cursor: pointer; }
  .mobile-tabs button span:first-child { font-size: 17px; }
  .mobile-tabs button.active { color: var(--purple); background: #f1efff; }
}

@media (max-width: 640px) {
  body { font-size: 14px; }
  .topbar { gap: 8px; }
  .mobile-brand strong { font-size: 13px; }
  .mobile-brand .brand-mark { width: 32px; height: 32px; }
  .top-metrics { gap: 5px; }
  .metric-pill { padding: 7px 9px; font-size: 10px; }
  .install-button { padding: 8px 10px; font-size: 10px; }
  #screen { padding: 18px 13px 106px; }
  .page-head { align-items: flex-start; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .page-head h1, .page-head h2 { font-size: 27px; }
  .page-head p { font-size: 12px; }
  .dashboard-grid { grid-template-columns: 1fr; gap: 12px; }
  .hero-card { grid-column: 1; min-height: 245px; padding: 23px 21px; border-radius: 22px; }
  .hero-card h2 { font-size: 32px; }
  .hero-card p { font-size: 12px; }
  .hero-actions { margin-top: 17px; }
  .hero-actions .btn { min-height: 38px; padding: 8px 11px; font-size: 10px; }
  .streak-card { min-height: 166px; padding: 18px; }
  .streak-top h3 { font-size: 15px; }
  .streak-number { font-size: 29px; }
  .stat-row { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 7px; }
  .stat-card { min-height: 98px; grid-template-columns: 1fr; grid-template-rows: 29px auto auto; row-gap: 4px; padding: 10px 9px; }
  .stat-icon { grid-row: auto; width: 27px; height: 27px; border-radius: 9px; font-size: 12px; }
  .stat-card strong { font-size: 14px; }
  .stat-card small { font-size: 8px; line-height: 1.25; }
  .progress-chart { margin-top: 12px; padding: 16px 11px 12px; border-radius: 19px; }
  .chart-heading { padding-inline: 3px; }
  .chart-heading h2 { font-size: 14px; }
  .chart-heading p { max-width: 230px; font-size: 9px; }
  .chart-key { font-size: 8px; }
  .chart-bars, .chart-labels { grid-template-columns: repeat(12, minmax(0,1fr)); gap: 4px; }
  .chart-bars { min-height: 119px; }
  .chart-bar-wrap { width: min(100%,22px); height: 88px; border-radius: 7px 7px 3px 3px; }
  .chart-labels { font-size: 7px; }
  .chart-caption { font-size: 8px; }
  .content-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
  .panel { padding: 16px; border-radius: 19px; }
  .panel-head h2 { font-size: 15px; }
  .duration-toggle button { padding: 6px 7px; font-size: 9px; }
  .task-item { padding: 11px; }
  .task-item strong { font-size: 11px; }
  .lesson-grid, .reference-list { grid-template-columns: 1fr; gap: 11px; }
  .lesson-body { padding: 15px; }
  .day-card { grid-template-columns: 43px minmax(0,1fr) auto; gap: 9px; padding: 10px; }
  .day-card > :first-child { width: 40px; height: 40px; border-radius: 13px; }
  .day-meta strong { font-size: 11px; }
  .day-meta small, .day-status { font-size: 8px; }
  .scope-banner { padding: 12px; font-size: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
